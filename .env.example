# -----------------------------------------------------------------------------
# OpenChainer Environment Configuration
# -----------------------------------------------------------------------------

# Supabase Cache Layer
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_PUBLISHABLE_KEY=your_publishable_key

# -----------------------------------------------------------------------------
# Multi-Provider LLM Fallback Chain Configuration
# Order of fallback: Gemini -> Groq -> OpenRouter
# -----------------------------------------------------------------------------

# 1. Google Gemini (Primary Provider)
# Get a free key at: https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# 2. Groq LPU / Vision (Secondary Provider)
# Get a free key at: https://console.groq.com (No credit card required)
GROQ_API_KEY=your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1

# 3. OpenRouter Free Models (Tertiary Provider)
# Get a free key at: https://openrouter.ai (No credit card required)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
